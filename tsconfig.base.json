{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": [
      "@lms/source"
    ],
    "rootDir": ".",
    "paths": {
      "@lms/core-table": [
        "./packages/databases/core-table/src/index.ts"
      ],
      "@lms/common-scripts": [
        "./packages/common/scripts/src/index.ts"
      ],
      "@lms/common-constructs": [
        "./packages/common/constructs/src/index.ts"
      ]
    }
  }
}
